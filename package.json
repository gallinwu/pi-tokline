  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "tokens-per-second",
    "cache-hit-rate",
    "token-usage",
    "usage-tracker",
    "statusline",
    "tui",
    "observability",
    "cost-tracking",
    "developer-tools"
